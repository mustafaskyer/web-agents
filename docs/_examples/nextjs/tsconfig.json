{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // app/layout.tsx imports "./globals.css", which only exists in the reader's project
    "noUncheckedSideEffectImports": false,
    "paths": {
      "@/components/ui/*": ["../../../apps/nextjs/components/ui/*"],
      // "@/" is the project root in a Next.js app
      "@/*": ["./*", "../shared/*"]
    }
  },
  "include": ["app", "components", "../shared"]
}
