{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    // The installation pages import relatively (a starter may set no
    // "@/" alias): src and shared are one folder
    "rootDirs": ["./src", "../shared"],
    "paths": {
      "@/components/ui/*": ["../../../examples/ui/src/components/*"],
      "@/*": ["./src/*", "../shared/*"]
    }
  },
  "include": ["src", "../shared"]
}
