{
  "name": "@web-agents/local-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "An on-device agent for @web-agents/chat: a small model in a Web Worker (transformers.js, WebGPU/WASM) or Chrome's built-in Prompt API. No server, no key, nothing leaves the browser.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "@web-agents/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "@web-agents/source": "./src/providers/transformers/worker.ts",
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check-exports": "publint && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@web-agents/chat": "workspace:^"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@web-agents/chat": "workspace:*",
    "@web-agents/core": "workspace:*",
    "tsdown": "^0.23.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustafaskyer/web-agents.git",
    "directory": "packages/local-agent"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
