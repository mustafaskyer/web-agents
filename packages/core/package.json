{
  "name": "@web-agents/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Show users what a WebMCP agent is doing: ghost cursor, field replay, confirmation parking.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@web-agents/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cursor.css": {
      "@web-agents/source": "./src/cursor.css",
      "default": "./dist/cursor.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "zod": "^4.6.7",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  }
}
