{
  "name": "@web-agents/chat",
  "version": "0.1.0",
  "type": "module",
  "description": "A chat widget whose agent operates the live page through its WebMCP tools: pluggable agents, a cloud adapter for Claude, a server handler and a Vite dev plugin.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@web-agents/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "@web-agents/source": "./src/server/index.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./vite": {
      "@web-agents/source": "./src/vite/index.ts",
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./chat.css": {
      "@web-agents/source": "./src/chat.css",
      "default": "./dist/chat.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": ">=4",
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@web-agents/core": "workspace:^",
    "ai": "^7.0.163",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/provider": "^4.0.36",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@web-agents/polyfill": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "vite": "^8.3.6",
    "vitest-browser-react": "^2.3.0"
  }
}
