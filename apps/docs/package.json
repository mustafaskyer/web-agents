{
  "name": "@webmcp-agents/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "turbo run build --filter=@webmcp-agents/docs^...",
    "dev": "blume dev",
    "registry": "shadcn build registry/registry.json --cwd ../.. --output apps/docs/public/r",
    "build": "pnpm run registry && blume build",
    "preview": "blume preview",
    "test": "blume validate && node scripts/check-docs.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@webmcp-agents/core": "workspace:*",
    "@webmcp-agents/react": "workspace:*",
    "@webmcp-agents/tools": "workspace:*",
    "blume": "^2.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.19"
  }
}
