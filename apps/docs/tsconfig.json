{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    // the workspace packages' source, like the other apps: typecheck needs no build first
    "customConditions": ["@webmcp-agents/source"],
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": ["components/**/*.ts", "components/**/*.tsx", "lib/**/*.ts", "types.d.ts"],
  "exclude": ["node_modules", ".blume", "dist", "components/**/example.tsx"]
}
