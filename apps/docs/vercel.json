        }
      ]
    },
    {
      "source": "/blume-assets/(.*).svg",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
