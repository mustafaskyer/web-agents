# Server-side only: read by @webmcp-agents/chat/vite in dev (and by api/chat.ts on Vercel).
# Copy to .env.local. Never prefix with VITE_: those variables are shipped to the browser (the dev plugin refuses them).

# The model, as <provider>/<model>, and that provider's key. Pick one:
WEB_AGENTS_MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=
# WEB_AGENTS_MODEL=openai/gpt-5.5                            # pnpm add @ai-sdk/openai
# OPENAI_API_KEY=
# WEB_AGENTS_MODEL=deepseek/deepseek-v4                      # pnpm add @ai-sdk/deepseek
# DEEPSEEK_API_KEY=
# WEB_AGENTS_MODEL=openrouter/anthropic/claude-opus-5.5      # pnpm add @openrouter/ai-sdk-provider; any model behind one key
# OPENROUTER_API_KEY=
# WEB_AGENTS_MODEL=google/gemini-3-pro                       # no provider package: the AI Gateway
# AI_GATEWAY_API_KEY=
