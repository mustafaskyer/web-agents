{
  "name": "web-agents",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=./apps/*",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome ci . && turbo run typecheck test build size",
    "size": "turbo run size",
    "e2e": "turbo run e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "publint": "^0.3.25",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
