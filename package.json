{
  "name": "web-agents",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=./apps/* --filter=./examples/*",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome ci . && turbo run typecheck test build size && pnpm registry:typecheck && pnpm registry:test",
    "size": "turbo run size",
    "e2e": "turbo run e2e",
    "registry:build": "pnpm --filter @webmcp-agents/docs registry",
    "registry:test": "vitest run --root registry",
    "registry:typecheck": "tsc -p registry/tsconfig.json",
    "capture": "playwright test -c capture/playwright.config.ts && node capture/encode.mjs",
    "capture:typecheck": "tsc -p capture/tsconfig.json",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "release:status": "node scripts/release.mjs status",
    "release:version": "node scripts/release.mjs version",
    "release:publish": "node scripts/release.mjs publish",
    "release:snapshot": "node scripts/release.mjs snapshot"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@webmcp-agents/devtools": "workspace:*",
    "ajv": "^8.20.0",
    "playwright": "^1.65.0",
    "publint": "^0.3.25",
    "shadcn": "^4.23.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*",
    "docs/_examples"
  ],
  "overrides": {
    "blume>satteri": "0.11.7"
  }
}
