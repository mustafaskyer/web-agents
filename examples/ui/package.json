{
  "name": "@webmcp-agents/examples-ui",
  "private": true,
  "version": "0.0.0",
  "description": "The shadcn/ui components (base-nova, Base UI, lucide, Tailwind v4) every example is made of. Source only, no build.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/*": "./src/lib/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  }
}
